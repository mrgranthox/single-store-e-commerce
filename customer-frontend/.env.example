# Production / Netlify / any static host: **required** — your deployed Express API origin (no trailing slash).
# The customer app never calls /api on the static host (Netlify has no Express); without this, auth and
# all API calls fail with 404.
# VITE_BACKEND_BASE_URL=https://single-store-e-commerce-api.onrender.com

# Local dev only — Vite proxy target (see vite.config.ts)
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:4000
